  "archive": {
    "forward/1": {
      "text": "Peru stated that the Mechanism's fight against impunity relied on states enforcing sentences, executing warrants, and fulfilling assistance requests. Peru urged the Council to remain united behind the Mechanism and actively secure this necessary cooperation.",
      "format": true,
      "grade": 50,
      "guard": "clear",
      "met": [
        "per-cooperation",
        "per-unity"
      ]
    },
    "forward/2": {
      "text": "Russia explained its abstention, noting that earlier warnings regarding the reappointment of former Yugoslavia Tribunal officials were borne out. It criticized the Mechanism's staffing and administration, specifically questioning the adequacy of Ratko Mladić's medical care. Russia recalled requesting his temporary release to Russia for treatment, contingent upon Russian guarantees, if prison doctors failed to provide adequate care.",
      "format": true,
      "grade": 52,
      "guard": "clear",
      "met": [
        "rus-medical",
        "rus-staffing"
      ]
    },
    "forward/3": {
      "text": "Peru urged the Council to remain united behind the Mechanism, emphasizing that combating impunity depended on states enforcing sentences, carrying out warrants, and answering assistance requests. Russia, citing its earlier warnings about reappointing former Yugoslavia tribunal officials, criticized the Mechanism's staffing and administration. It questioned the adequacy of Ratko Mladić's medical care, recalling its request for temporary release to Russia for treatment if prison doctors failed to provide it, under Russian guarantees.",
      "format": false,
      "grade": 0,
      "guard": "clear",
      "met": [
        "per-cooperation",
        "per-unity",
        "rus-medical"
      ]
    },
    "forward/4": {
      "text": "Serbia complained that the Mechanism refused Ratko Mladić's temporary release for medical treatment, despite guarantees from the Serbian Government. Serbia stated it was meeting its cooperation obligations and remained committed to prosecuting war crimes regardless of the perpetrators' nationality.",
      "format": true,
      "grade": 49,
      "guard": "clear",
      "met": [
        "srb-cooperation",
        "srb-release"
      ]
    },
    "forward/5": {
      "text": "Peru urged the Council to remain united behind the Mechanism, emphasizing that combating impunity depended on states enforcing sentences and answering assistance requests. Conversely, Serbia objected to the Mechanism's refusal to grant temporary medical release to Ratko Mladić, despite guarantees from the Serbian Government. Serbia maintained it was fulfilling its cooperation obligations and remained committed to prosecuting war crimes regardless of nationality.",
      "format": true,
      "grade": 0,
      "guard": "uncertain",
      "met": [
        "per-cooperation",
        "per-unity",
        "srb-cooperation",
        "srb-release"
      ]
    },
    "forward/6": {
      "text": "Russia complained that the Mechanism's staffing was inadequate and questioned Ratko Mladić's medical care, recalling its request for his temporary release to Russia if local doctors failed. Serbia objected that the Mechanism refused this release despite Serbian guarantees, yet maintained it was fulfilling its cooperation obligations to prosecute war crimes regardless of nationality.",
      "format": true,
      "grade": 0,
      "guard": "uncertain",
      "met": []
    },
    "forward/7": {
      "text": "Peru urged Council unity to enforce sentences and warrants. Russia criticized staffing, questioned Mladić's medical care, and recalled requesting his temporary release to Russia if local doctors failed, citing Russian guarantees. Serbia objected to the Mechanism's refusal of Mladić's release despite Serbian guarantees, yet affirmed its commitment to prosecuting war crimes regardless of nationality.",
      "format": true,
      "grade": 55,
      "guard": "clear",
      "met": [
        "per-unity",
        "rus-medical",
        "srb-release"
      ]
    },
    "reverse/3": {
      "text": "Russia attributed its abstention to confirmed warnings regarding the Mechanism's staffing and administration, specifically citing inadequate medical care for Ratko Mladić and recalling its request for temporary release to Russia if local doctors failed. Peru complained that the Mechanism's ability to combat impunity depended on states enforcing sentences and fulfilling requests for assistance, urging the Council to remain united in securing this cooperation.",
      "format": true,
      "grade": 0,
      "guard": "uncertain",
      "met": [
